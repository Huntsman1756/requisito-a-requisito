{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datawardsmadrid.local/schemas/citizen-profile.schema.json",
  "title": "Perfil del ciudadano (solo en memoria del navegador)",
  "description": "Nunca se envía ni se persiste fuera del navegador. Usado también en fixtures de tests y personas golden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "answers"],
  "properties": {
    "catalogVersion": { "type": "integer" },
    "answers": {
      "type": "object",
      "description": "Clave = field del catálogo. Campos ausentes = unasked.",
      "additionalProperties": { "$ref": "#/$defs/answer" }
    }
  },
  "$defs": {
    "answer": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "enum": ["unknown", "declined", "unasked"] } } },
        {
          "type": "object", "additionalProperties": false, "required": ["state", "value"],
          "properties": {
            "state": { "const": "value" },
            "value": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } },
                { "type": "integer" },
                { "$ref": "#/$defs/interval" },
                { "$ref": "#/$defs/monthYear" },
                { "$ref": "#/$defs/territory" },
                { "type": "array", "items": { "$ref": "#/$defs/dependent" } }
              ]
            }
          }
        }
      ]
    },
    "interval": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "type": ["number", "null"] }, "max": { "type": ["number", "null"] }, "maxExclusive": { "type": "boolean", "default": true } }
    },
    "monthYear": {
      "type": "object", "additionalProperties": false, "required": ["year", "month"],
      "properties": { "year": { "type": "integer", "minimum": 1900 }, "month": { "type": "integer", "minimum": 1, "maximum": 12 } }
    },
    "territory": {
      "type": "object", "additionalProperties": false, "required": ["ccaa"],
      "properties": {
        "ccaa": { "type": "string", "pattern": "^[0-9]{2}$", "description": "Código INE CCAA" },
        "province": { "type": "string", "pattern": "^[0-9]{2}$" },
        "municipality": { "type": "string", "pattern": "^[0-9]{5}$" }
      }
    },
    "dependent": {
      "type": "object", "additionalProperties": false, "required": ["age"],
      "properties": {
        "age": { "$ref": "#/$defs/interval" },
        "disability": { "enum": ["yes", "no", "unknown", "declined"] }
      }
    }
  }
}
