{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datawardsmadrid.local/schemas/golden-persona.schema.json",
  "title": "Persona golden — oráculo jurídico revisado por humano",
  "description": "la-ayuda/tests/eligibility/golden/<id>.json. Perfil ficticio + resultado esperado por ayuda, justificado con cita y revisado por Daniel.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "today", "profile", "expectations", "review"],
  "properties": {
    "id": { "type": "string", "pattern": "^gp-[a-z0-9-]+$" },
    "description": { "type": "string", "description": "Ej: 'Madre monoparental, 2 hijos (1 y 4 años), Getafe, ingresos 18–22k'" },
    "today": { "type": "string", "format": "date" },
    "profile": { "$ref": "citizen-profile.schema.json" },
    "expectations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["benefitSlug", "rulesVersion", "verdict", "justification"],
        "properties": {
          "benefitSlug": { "type": "string" },
          "rulesVersion": { "type": "integer", "description": "Si el RuleSet sube de versión, el golden debe revisarse" },
          "verdict": { "enum": ["probable", "posible", "insuficiente", "no_cumple"] },
          "deadlineState": { "enum": ["OPEN", "UPCOMING", "CLOSED", "ROLLING", "UNKNOWN"] },
          "missingFields": { "type": "array", "items": { "type": "string" } },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "futureFrom": { "type": "string", "format": "date" },
          "justification": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["sourceId", "locator", "reasoning"],
              "properties": { "sourceId": { "type": "string" }, "locator": { "type": "string" }, "reasoning": { "type": "string" } }
            }
          }
        }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "by": { "type": "string" },
        "at": { "type": "string", "format": "date" }
      }
    }
  }
}
