{
	"name": "requisito-a-requisito",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.6"
	},
	"description": "Orientador de ayudas públicas de la Comunidad de Madrid con fuente oficial verificable",
	"scripts": {
		"dev": "next dev",
		"build": "npm run eligibility:build && npm run datos:public && next build",
		"check": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "node ./node_modules/vitest/vitest.mjs run",
		"test:e2e": "playwright test",
		"preview": "node scripts/serve-export.mjs",
		"catalog:import": "tsx ./scripts/import-donor-catalog.ts",
		"validate:full": "npm run eligibility:build && npm run datos:public && npm run check && npm run lint && npm test && npm run build",
		"eligibility:snapshot": "tsx ./scripts/eligibility-snapshot.ts",
		"eligibility:validate": "tsx ./scripts/eligibility-validate.ts",
		"eligibility:build": "tsx ./scripts/eligibility-build.ts",
		"eligibility:exhaustive": "tsx ./scripts/eligibility-exhaustive.ts",
		"eligibility:build:release": "tsx ./scripts/eligibility-build.ts --strict",
		"review:sheet": "tsx ./scripts/review-sheet.ts",
		"rules:fill-hashes": "tsx ./scripts/ruleset-fill-hashes.ts",
		"datos:public": "tsx ./scripts/publish-public-data.ts",
		"coverage:engine": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/lib/eligibility-engine/**' --coverage.reporter=text",
		"universe:build": "tsx scripts/universe/build.ts",
		"freshness": "tsx scripts/freshness.ts",
		"freshness:local": "cross-env FRESHNESS_LOCAL=1 tsx scripts/freshness.ts --only-skipped",
		"link:check": "tsx scripts/link-check.ts",
		"panel:ping": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local ./scripts/review-panel/ping.ts",
		"panel:run": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local ./scripts/review-panel/run.ts",
		"panel:calibrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local ./scripts/review-panel/calibrate.ts",
		"eligibility:mutate": "tsx ./scripts/eligibility-mutate.ts",
		"review:apply": "tsx ./scripts/review-apply.ts",
		"memoria:cifras": "tsx ./scripts/memoria-cifras.ts",
		"memoria:pdf": "tsx ./scripts/memoria-pdf.ts",
		"piloto:agregados": "tsx ./scripts/piloto-agregados.ts",
		"muestreo:indice": "tsx ./scripts/muestreo-indice.ts",
		"anexos": "tsx scripts/anexos.ts",
		"build:release": "npm run eligibility:build:release && npm run datos:public && next build",
		"release:verify": "tsx ./scripts/release-verify.ts",
		"validate:release": "npm run check && npm run lint && npm test && npm run build:release && npm run release:verify && npm run completeness:verify && npm run completeness:web",
		"completeness:verify": "tsx scripts/completeness-report.ts --bundle out/datos/elegibilidad/bundle.json",
		"completeness:web": "playwright test tests/e2e/completeness.spec.ts --project=desktop-chromium",
		"territory:lite": "tsx scripts/territory-lite.ts",
		"universe:municipal": "node --use-system-ca --import tsx ./scripts/universe/municipal-seed.ts"
	},
	"dependencies": {
		"js-yaml": "^5.4.2",
		"next": "^15.5.25",
		"pdfjs-dist": "^6.3.289",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "^2.4.13",
		"@playwright/test": "^1.61.1",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.20.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^4.1.11",
		"cross-env": "^7.0.3",
		"tsx": "^4.23.0",
		"typescript": "^5.6.0",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"postcss": "8.5.29"
	}
}