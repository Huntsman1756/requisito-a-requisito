{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(**/.env)",
			"Read(**/.env.*)",
			"Read(**/*.pem)",
			"Read(**/*.key)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "node \"F:/_Proyectos/datawardsmadrid/.claude/hooks/push-guard.js\"",
						"timeout": 10
					}
				]
			}
		]
	}
}
